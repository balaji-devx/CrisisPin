<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Bluetooth ─────────────────────────────────────────────────────── -->
    <!-- Legacy support for Android < 12 -->
    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>

    <!-- Android 12+ BLE permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- Location required for BLE scanning -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- ── Service ──────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>

    <!-- ── Notifications ────────────────────────────────────────────────── -->
    <!-- Android 13+ requires runtime permission request — handled in PermissionHelper -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ── Vibration ────────────────────────────────────────────────────── -->
    <!-- Declared here; no runtime grant needed — manifest is enough -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- ── Boot ─────────────────────────────────────────────────────────── -->
    <!-- Required for BootReceiver to start scanning after device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- ── Battery optimization ─────────────────────────────────────────── -->
    <!-- Lets app ask user to whitelist it — keeps service alive on Xiaomi/MIUI -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- BLE hardware required to install app -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrisisPin">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CrisisPin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!--
            foregroundServiceType="connectedDevice" is required for Android 14+
            when a foreground service uses Bluetooth.
            Without this, startForegroundService() throws on API 34+.
        -->
        <service
            android:name=".service.CrisisPinService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"/>


        <!--
            BootReceiver: starts CrisisPinService automatically after device boot.
            This means BLE scanning runs without user ever opening the app —
            as long as Bluetooth is on and permissions were granted at least once.

            QUICKBOOT_POWERON handles Xiaomi/Huawei fast-boot (partial reboot).
            Both actions are needed for full compatibility.
        -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </receiver>


        <!--
            BluetoothReceiver: manifest-registered so it wakes even when service is stopped.
            Starts CrisisPinService the moment BT is turned on — no app open needed.
        -->
        <receiver
            android:name=".receiver.BluetoothReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>